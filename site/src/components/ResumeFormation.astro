---
// Résumé d'une formation dans une liste (carte cliquable). Les attributs data-* servent au
// filtrage et au tri côté navigateur sur la page d'accueil ; ils ne contiennent que des
// données publiques. La recherche lit le texte visible de la carte (intitulé, organisme,
// disciplines, lieu…) : il n'est pas répété dans un attribut, la page reste légère. Un seul lien par carte (le titre) : toute la carte est cliquable grâce
// au CSS (lien étiré), et les lecteurs d'écran n'entendent qu'un lien.
import { villesDe, regroupementsDe, tarifLisible, aidesDe, prochaineSession, dateCourte } from "../lib/donnees.js";
import { sessionActive } from "../lib/carte-moteur.js";

const { formation: f, donnees } = Astro.props;
const ref = donnees.referentiels;
const organisme = donnees.organisme(f.organisme);
const villes = villesDe(f, donnees);
const tarif = tarifLisible(f.tarif);
const aides = aidesDe(f, ref);
// Prochaine session datée (les éditions passées et les sessions sans date sont ignorées).
const prochaine = prochaineSession(f, donnees);
// Lieux des sessions en cours ou à venir : la liste et la carte s'accordent sur ces identifiants.
const aujourdhui = new Date().toISOString().slice(0, 10);
const lieux = [...new Set(f.sessions.filter((s) => s.lieu && sessionActive(s, aujourdhui)).map((s) => s.lieu))];
const aReperes = Boolean(prochaine || villes.length || f.duree || tarif);
---
<li
  class="fiche-resume"
  data-id={f.id}
  data-lieux={lieux.length ? lieux.join(" ") : undefined}
  data-disciplines={f.disciplines.join(" ")}
  data-type={f.type}
  data-secteur={f.secteur}
  data-villes={regroupementsDe(f, donnees).join("|")}
  data-aides={f.financement.length ? f.financement.join(" ") : undefined}
  data-precisions={f.precisions ?? undefined}
  data-debut={prochaine?.debut}
  data-prix={f.tarif.euros ?? undefined}
>
  <ul class="etiquettes" aria-label="Type et disciplines">
    <li class="etiquette forte">{ref.types[f.type] ?? f.type}</li>
    {f.disciplines.map((d) => <li class="etiquette">{ref.disciplines[d] ?? d}</li>)}
  </ul>
  {aides.length > 0 && <p class="badge-aides">Éligible aux aides : {aides.join(", ")}</p>}
  <h3><a href={`/formations/${f.slug}/`}>{f.intitule}</a></h3>
  {organisme && <p class="resume-organisme">{organisme.nom}</p>}
  {aReperes && (
  <ul class="reperes">
    {prochaine ? (
      <li class="r-session"><span class="discret libelle">Prochaine session :</span> <b>{dateCourte(prochaine.debut)}</b>{prochaine.ville && `, ${prochaine.ville}`}</li>
    ) : (
      villes.length > 0 && <li class="r-lieu"><span class="invisible">Lieu : </span>{villes.join(", ")}</li>
    )}
    {f.duree && <li class="r-duree"><span class="invisible">Durée : </span>{f.duree}</li>}
    {tarif && <li class="r-tarif chiffres"><span class="invisible">Tarif : </span>{tarif}</li>}
  </ul>
  )}
</li>
