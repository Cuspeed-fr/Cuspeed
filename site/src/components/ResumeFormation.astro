---
// Résumé d'une formation dans une liste. Les attributs data-* servent au filtrage
// côté navigateur sur la page d'accueil ; ils ne contiennent que des données publiques.
import { villesDe, regroupementsDe, tarifLisible, enSlug } from "../lib/donnees.js";

const { formation: f, donnees } = Astro.props;
const ref = donnees.referentiels;
const organisme = donnees.organisme(f.organisme);
const villes = villesDe(f, donnees);
const tarif = tarifLisible(f.tarif);
const texteRecherche = enSlug(
  [f.intitule, organisme?.nom, ...villes, ...f.disciplines.map((d) => ref.disciplines[d]), f.precisions ?? ""].join(" "),
).replace(/-/g, " ");
---
<li
  class="fiche-resume"
  data-disciplines={f.disciplines.join(" ")}
  data-type={f.type}
  data-secteur={f.secteur}
  data-villes={regroupementsDe(f, donnees).join("|")}
  data-texte={texteRecherche}
>
  <ul class="etiquettes" aria-label="Type et disciplines">
    <li class="etiquette forte">{ref.types[f.type] ?? f.type}</li>
    {f.disciplines.map((d) => <li class="etiquette">{ref.disciplines[d] ?? d}</li>)}
  </ul>
  <h3><a href={`/formations/${f.slug}/`}>{f.intitule}</a></h3>
  <div class="meta">
    {organisme && <span>{organisme.nom}</span>}
    {villes.length > 0 && <span>{villes.join(", ")}</span>}
    {f.duree && <span>{f.duree}</span>}
    {tarif && <span class="chiffres">{tarif}</span>}
  </div>
</li>
