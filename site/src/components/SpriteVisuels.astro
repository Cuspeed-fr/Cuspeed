---
// Les dessins des disciplines, définis une seule fois par page (<symbol>) ; chaque carte les
// réutilise avec <use> au lieu de répéter le dessin (page d'accueil plus légère).
// Les dessins sont des chaînes fixes du code (lib/visuels.js), jamais des données de la base.
import { VISUELS, DENT } from "../lib/visuels.js";

const symboles = [...Object.entries(VISUELS).map(([code, v]) => [code, v.dessin]), ["dent", DENT]]
  .map(([code, dessin]) => `<symbol id="v-${code}" viewBox="0 0 48 48">${dessin}</symbol>`)
  .join("");
---
<svg class="sprite-visuels" aria-hidden="true" focusable="false" width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden" set:html={symboles} />
