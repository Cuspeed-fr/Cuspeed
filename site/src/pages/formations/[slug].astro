---
// Fiche d'une formation : une page par formation publiée.
import Base from "../../layouts/Base.astro";
import Visuel from "../../components/Visuel.astro";
import LogoOrganisme from "../../components/LogoOrganisme.astro";
import { chargerDonnees, tarifLisible, aidesDe, sessionsTriees, dateLisible, dateCourte, villesDe, couper } from "../../lib/donnees.js";

export function getStaticPaths() {
  const donnees = chargerDonnees();
  return donnees.formations.map((formation) => ({
    params: { slug: formation.slug },
    props: { formation },
  }));
}

const { formation: f } = Astro.props;
const donnees = chargerDonnees();
const ref = donnees.referentiels;
const organisme = donnees.organisme(f.organisme);
const villes = villesDe(f, donnees);
const tarif = tarifLisible(f.tarif);
const aides = aidesDe(f, ref);
// Éditions passées : retirées de la page et des données structurées, mais gardées en base.
// Ordre chronologique, les sessions sans date à la fin.
const sessions = sessionsTriees(f);
// État des inscriptions affiché sur la frise. « À renseigner » n'est pas une information
// pour le visiteur : rien n'est affiché (un champ inconnu reste vide).
const etatInscriptions = (code) => {
  if (!code || code === "a-renseigner") return null;
  const libelle = ref.inscriptions[code] ?? code;
  if (code === "ouvertes" || code === "fermees") return `Inscriptions ${libelle.toLowerCase()}`;
  return libelle;
};
const typeNom = ref.types[f.type] ?? f.type;
const disciplines = f.disciplines.map((d) => ref.disciplines[d] ?? d);
const lienFiche = new URL(`/formations/${f.slug}/`, Astro.site).href;

// Titre et description uniques pour les moteurs de recherche.
const titre = villes.length ? `${f.intitule} – ${villes.join(", ")}` : f.intitule;
// L'intitulé et la ville rendent chaque description unique (comme le titre).
const morceaux = [
  `${titre} : ${typeNom}${disciplines.length ? " en " + disciplines.join(", ").toLowerCase() : ""}`,
  organisme ? `Organisme : ${organisme.nom}` : null,
  f.duree ? `Durée : ${f.duree}` : null,
  tarif ? `Tarif : ${tarif}` : null,
];
// Les moteurs affichent environ 160 caractères : on coupe proprement à la fin d'un mot.
const description = couper(morceaux.filter(Boolean).join(". ") + ". Source officielle citée.", 160);

// Données structurées schema.org (Course). Seules les informations connues sont écrites.
const instances = sessions
  .map((s) => {
    const lieu = s.lieu ? donnees.lieu(s.lieu) : null;
    const instance = { "@type": "CourseInstance" };
    if (f.format === "en-ligne") instance.courseMode = "online";
    else if (f.format === "hybride") instance.courseMode = "blended";
    else if (f.format === "presentiel") instance.courseMode = "onsite";
    if (s.debut) instance.startDate = s.debut;
    if (s.fin) instance.endDate = s.fin;
    if (lieu?.latitude != null) {
      instance.location = { "@type": "Place", name: lieu.nom, address: { "@type": "PostalAddress", addressLocality: lieu.nom, addressCountry: "FR" } };
    }
    return Object.keys(instance).length > 1 ? instance : null;
  })
  .filter(Boolean);

const cours = {
  "@context": "https://schema.org",
  "@type": "Course",
  name: f.intitule,
  description,
  url: lienFiche,
  sameAs: f.url_officielle,
  inLanguage: "fr",
  educationalCredentialAwarded: ref.types_universitaires.includes(f.type) ? typeNom : undefined,
  provider: organisme ? { "@type": "Organization", name: organisme.nom, sameAs: organisme.site_web ?? organisme.page_catalogue ?? undefined } : undefined,
  about: disciplines.length ? disciplines : undefined,
  hasCourseInstance: instances.length ? instances : undefined,
  offers: f.tarif.euros != null ? { "@type": "Offer", category: "Paid", price: f.tarif.euros, priceCurrency: "EUR" } : undefined,
};

const fil = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Formations", item: new URL("/", Astro.site).href },
    organisme && { "@type": "ListItem", position: 2, name: organisme.nom, item: new URL(`/organismes/${organisme.slug}/`, Astro.site).href },
    { "@type": "ListItem", position: organisme ? 3 : 2, name: f.intitule, item: lienFiche },
  ].filter(Boolean),
};
---
<Base titre={titre} description={description} donneesStructurees={[cours, fil]}>
  <nav class="fil" aria-label="Fil d'Ariane">
    <ol>
      <li><a href="/">Formations</a></li>
      {organisme && <li><a href={`/organismes/${organisme.slug}/`}>{organisme.nom}</a></li>}
      <li aria-current="page">{f.intitule}</li>
    </ol>
  </nav>

  <article class="fiche">
    <header class="fiche-entete">
      <Visuel disciplines={f.disciplines} classe="fiche-banniere" />
      <ul class="etiquettes" aria-label="Type, secteur et disciplines">
        <li class="etiquette forte">{typeNom}</li>
        <li class="etiquette">{ref.secteurs[f.secteur] ?? f.secteur}</li>
        {disciplines.map((d) => <li class="etiquette">{d}</li>)}
      </ul>
      <h1>{f.intitule}</h1>
      {organisme && (
        <p class="organisme">
          <LogoOrganisme organisme={organisme} taille={28} />
          <a href={`/organismes/${organisme.slug}/`}>{organisme.nom}</a>
          {villes.length > 0 && <span class="discret"> · {villes.join(", ")}</span>}
        </p>
      )}
    </header>

    <div class="fiche-corps">
      <section class="carte-bloc" aria-labelledby="infos-titre">
        <h2 id="infos-titre">En bref</h2>
        <dl class="infos">
          <dt>Format</dt>
          <dd>{f.format ? ref.formats[f.format] ?? f.format : <span class="discret">Non précisé par la source</span>}</dd>
          <dt>Durée</dt>
          <dd>{f.duree ?? <span class="discret">Non précisée par la source</span>}</dd>
          {f.volume_horaire_h != null && (
            <>
              <dt>Volume horaire</dt>
              <dd class="chiffres">{f.volume_horaire_h} h</dd>
            </>
          )}
          <dt>Tarif</dt>
          <dd>
            {tarif ? (
              <span class="chiffres">{tarif}</span>
            ) : (
              <span class="discret">Non communiqué : à demander à l'organisme</span>
            )}
            {f.secteur === "universitaire" && tarif && <span class="discret"> · formation continue</span>}
          </dd>
          {f.prerequis && (
            <>
              <dt>Prérequis</dt>
              <dd>{f.prerequis}</dd>
            </>
          )}
          {f.precisions && (
            <>
              <dt>À savoir</dt>
              <dd>{f.precisions}</dd>
            </>
          )}
          {aides.length > 0 && (
            <>
              <dt>Éligible aux aides</dt>
              <dd>{aides.join(", ")} <span class="discret">(selon la source)</span></dd>
            </>
          )}
        </dl>
      </section>

      <section class="carte-bloc" aria-labelledby="sessions-titre">
        <h2 id="sessions-titre">Sessions</h2>
        {sessions.length === 0 ? (
          <p class="discret">Aucune session annoncée pour le moment.</p>
        ) : (
          <ol class="frise">
            {sessions.map((s) => {
              const lieu = s.lieu ? donnees.lieu(s.lieu) : null;
              const etat = etatInscriptions(s.inscriptions);
              return (
                <li class:list={["frise-etape", { "sans-date": !s.debut }]}>
                  {/* Date en tête quand elle est connue ; sinon la ville, et « Dates non publiées » dessous */}
                  <p class="frise-titre">
                    {s.debut ? (
                      <>
                        <time datetime={s.debut}>{dateCourte(s.debut)}</time>
                        {s.fin && <> au <time datetime={s.fin}>{dateCourte(s.fin)}</time></>}
                      </>
                    ) : (
                      lieu?.nom ?? "Lieu non précisé"
                    )}
                  </p>
                  <p class="frise-detail">
                    {s.debut ? <span>{lieu?.nom ?? "Lieu non précisé"}</span> : <span class="discret">Dates non publiées</span>}
                    {etat && <span class:list={["etat", `etat-${s.inscriptions}`]}>{etat}</span>}
                    {s.places != null && <span class="discret chiffres">{s.places} places</span>}
                  </p>
                </li>
              );
            })}
          </ol>
        )}
      </section>

      <section class="carte-bloc source" aria-labelledby="source-titre">
        <h2 id="source-titre">Source officielle</h2>
        <p>
          Les informations de cette fiche viennent de la page officielle de l'organisme.
          {f.derniere_verification && <> Dernière vérification : <strong>{dateLisible(f.derniere_verification)}</strong>.</>}
        </p>
        <p class="lien-source"><a class="bouton" href={f.url_officielle} rel="noopener external">Voir la page officielle ↗</a></p>
        <p class="discret petit">
          Une information erronée ou périmée ? Écrivez à <span class="adresse">contact@cuspeed.fr</span> en indiquant
          la référence <span class="chiffres">{f.id}</span>.
        </p>
      </section>
    </div>
    {/* Sur téléphone, le lien vers la source reste à portée de pouce en bas de l'écran
        (CSS seul, sans JavaScript) ; il reprend sa place à la fin de la fiche. */}
    <div class="action-collante">
      <a class="bouton" href={f.url_officielle} rel="noopener external">Voir la page officielle ↗</a>
    </div>
  </article>
</Base>

<style>
  .fiche-entete {
    display: grid;
    gap: 10px;
    margin-bottom: 20px;
  }
  .fiche-entete h1 {
    margin: 0;
  }
  /* Bandeau dessiné de la discipline, en tête de fiche (comme la photo d'une annonce). */
  .fiche-entete :global(.fiche-banniere) {
    height: clamp(120px, 22vw, 200px);
    border-radius: var(--rayon);
    margin-bottom: 6px;
  }
  .fiche-entete :global(.fiche-banniere svg) {
    width: auto;
    height: 58%;
  }
  .organisme {
    margin: 0;
    font-size: 1.05rem;
  }
  .fiche-corps {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 920px) {
    .fiche-corps {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      align-items: start;
    }
    .fiche-corps > :first-child {
      grid-row: span 2;
    }
  }
  .carte-bloc h2 {
    margin-top: 0;
    font-size: 1.1rem;
  }
  /* Frise des sessions : une pastille par session, reliées par un trait vertical */
  .frise {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
  }
  .frise-etape {
    position: relative;
    padding: 0 0 16px 26px;
  }
  .frise-etape:last-child {
    padding-bottom: 0;
  }
  .frise-etape::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-doux);
  }
  .frise-etape.sans-date::before {
    background: var(--surface);
    border: 2px solid var(--point-vide);
    box-shadow: none;
  }
  .frise-etape:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 5px;
    top: calc(0.35em + 16px);
    bottom: 2px;
    width: 2px;
    background: var(--trait);
  }
  .frise-titre {
    margin: 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .frise-detail {
    margin: 2px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 10px;
  }
  .etat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-fort);
  }
  .etat::before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  .etat-ouvertes {
    color: var(--ok);
  }
  .etat-complet,
  .etat-fermees {
    color: var(--alerte);
  }
  /* Bouton collant (téléphone et tablette) ; sur grand écran, le bouton de la colonne suffit */
  .action-collante {
    position: sticky;
    bottom: 0;
    z-index: 5;
    margin: 16px -16px 0;
    padding: 10px 16px calc(10px + env(safe-area-inset-bottom, 0px));
    background: var(--fond);
    border-top: 1px solid var(--trait);
  }
  .action-collante .bouton {
    width: 100%;
  }
  @media (max-width: 919px) {
    .lien-source {
      display: none;
    }
  }
  @media (min-width: 920px) {
    .action-collante {
      display: none;
    }
  }
  .petit {
    font-size: 0.88rem;
  }
  .adresse {
    user-select: all;
    font-weight: 600;
    color: var(--encre);
  }
</style>
