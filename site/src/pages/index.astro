  }
  .champ {
    display: grid;
    gap: 5px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--discret);
    min-width: 0;
  }
  .champ input,
  .champ select,
  .tri select {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    color: var(--encre);
    background: var(--fond);
    border: 1px solid var(--bord-champ);
    border-radius: var(--rayon-petit);
    padding: 10px 12px;
    min-height: 46px;
    width: 100%;
    min-width: 0;
  }
  .champ input:focus,
  .champ select:focus,
  .tri select:focus {
    border-color: var(--accent);
  }
  .effacer {
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    min-height: 46px;
    color: var(--accent-fort);
    background: none;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-petit);
    padding: 10px 12px;
    cursor: pointer;
  }
  .effacer:hover {
    border-color: var(--accent);
  }

  /* Nombre de résultats et tri */
  .barre-resultat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 4px;
  }
  .resultat {
    margin: 0 2px;
    font-family: var(--titre);
    font-weight: 700;
    font-size: 1.25rem;
  }
  /* Le nombre de résultats reçoit le focus après une recherche (sans ouvrir le clavier) */
  .resultat:focus {
    outline: none;
  }
  .tri {
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--discret);
  }
  .tri select {
    width: auto;
    min-height: 40px;
    padding: 6px 10px;
    font-size: 0.95rem;
    background: var(--surface);
  }

  /* Puces des filtres actifs : un geste pour retirer un filtre. Elles sont créées par le
     script, d'où :global() (le style limité à la page ne les atteindrait pas). */
  .puces-actives {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .puces-actives :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 4px 8px 4px 12px;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent-fort);
    background: var(--accent-doux);
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .puces-actives :global(button:hover) {
    border-color: var(--accent);
  }
  .puces-actives :global(.croix) {
    font-size: 1.15rem;
    line-height: 1;
  }
  .puces-actives :global(.tout-effacer) {
    background: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding-inline: 8px;
  }

  /* Avant que le script ne prenne la main, seul le premier paquet s'affiche (pas de saut) */
  :global(.js) #liste:not(.pilotee) > li:nth-child(n + 25) {
    display: none;
  }
  .aucun {
    margin: 4px 2px;
  }
  .plus-bloc {
    justify-items: center;
    gap: 10px;
    margin-top: 8px;
    text-align: center;
  }
  .compteur {
    margin: 0;
    font-size: 0.9rem;
    color: var(--discret);
    font-variant-numeric: tabular-nums;
  }

  /* Méthode */
  .methode h2 {
    margin-top: 0;
  }
  .etapes {
    list-style: none;
    padding: 0;
    margin: 28px 0 20px;
    display: grid;
    gap: 16px;
  }
  @media (min-width: 760px) {
    .etapes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .etapes li {
    background: var(--fond);
    border-radius: var(--rayon);
    padding: 22px;
    min-width: 0;
  }
  .etapes h3 {
