  .point:focus-visible {
    outline: none;
  }
  .point:focus-visible .disque {
    stroke: var(--encre);
    stroke-width: 3;
  }

  /* Recherche et outils (Trier, Filtrer, Carte) : visibles seulement avec JavaScript */
  .filtres,
  .plus-bloc {
    display: none;
  }
  :global(.js) .filtres {
    display: grid;
    gap: 12px;
    margin-bottom: 12px;
    padding: 14px;
    scroll-margin-top: 12px;
  }
  :global(.js) .plus-bloc {
    display: grid;
  }
  .champ.champ-recherche input {
    min-height: 50px;
    border-radius: 999px;
    padding-inline: 20px;
  }
  .outils {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--trait);
    border-radius: var(--rayon-petit);
    overflow: hidden;
  }
  @media (min-width: 640px) {
    .outils {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      border: 0;
      border-radius: 0;
      overflow: visible;
    }
  }
  .outil {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 46px;
    min-width: 0;
    padding: 8px 14px;
    font: inherit;
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--accent-fort);
    background: var(--surface);
    border: 0;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  .outil + .outil {
    border-left: 1px solid var(--trait);
  }
  @media (min-width: 640px) {
    .outil,
    .outil + .outil {
      border: 1px solid var(--bord-champ);
      border-radius: 999px;
    }
  }
  .outil:hover {
    background: var(--accent-doux);
  }
  .outil[aria-pressed="true"],
  .outil[aria-expanded="true"],
  .outil.actif {
    background: var(--accent-doux);
    border-color: var(--accent);
  }
  .outil:focus-visible,
  .outil-tri:focus-within {
    outline: 3px solid var(--accent);
    outline-offset: -3px;
  }
  .icone {
    width: 20px;
    height: 20px;
    flex: none;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Trier : le menu natif couvre tout le bouton (sur téléphone, il ouvre le sélecteur du système). */
  .outil-tri select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    font-size: 16px;
    cursor: pointer;
  }
  .panneau-filtres {
    display: none;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    align-items: end;
    padding-top: 4px;
  }
  .filtres.ouvert .panneau-filtres {
    display: grid;
  }
  .compte-filtres {
    min-width: 22px;
    padding: 0 6px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-texte);
    font-size: 0.8rem;
    line-height: 22px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  /* Carte : visible sur grand écran, repliée sur téléphone, sauf choix fait avec le bouton Carte.
     Sans JavaScript (pas de bouton), elle reste toujours visible. */
  @media (max-width: 919px) {
    :global(.js) .disposition:not([data-carte="ouverte"]) .colonne-carte {
      display: none;
    }
  }
  @media (min-width: 920px) {
    :global(.js) .disposition[data-carte="fermee"] {
      grid-template-columns: minmax(0, 1fr);
    }
    :global(.js) .disposition[data-carte="fermee"] .colonne-carte {
      display: none;
    }
  }
  .champ {
    display: grid;
    gap: 5px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--discret);
    min-width: 0;
  }
  .champ input,
  .champ select {
    font: inherit;
    font-weight: 400;
    font-size: 1rem;
    color: var(--encre);
    background: var(--fond);
    border: 1px solid var(--bord-champ);
    border-radius: var(--rayon-petit);
    padding: 10px 12px;
    min-height: 46px;
    width: 100%;
    min-width: 0;
  }
  .champ input:focus,
  .champ select:focus {
    border-color: var(--accent);
