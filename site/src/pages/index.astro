  .puces-actives :global(button) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 4px 8px 4px 12px;
    font: inherit;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--accent-fort);
    background: var(--accent-doux);
    border: 1px solid transparent;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.15s;
  }
  .puces-actives :global(button:hover) {
    border-color: var(--accent);
  }
  .puces-actives :global(.croix) {
    font-size: 1.15rem;
    line-height: 1;
  }
  .puces-actives :global(.tout-effacer) {
    background: none;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding-inline: 8px;
  }

  /* Avant que le script ne prenne la main, seul le premier paquet s'affiche (pas de saut) */
  :global(.js) #liste:not(.pilotee) > li:nth-child(n + 25) {
    display: none;
  }
  .aucun {
    margin: 4px 2px;
  }
  .plus-bloc {
    justify-items: center;
    gap: 10px;
    margin-top: 8px;
    text-align: center;
  }
  .compteur {
    margin: 0;
    font-size: 0.9rem;
    color: var(--discret);
    font-variant-numeric: tabular-nums;
