  }

  /* Appel final */
  .appel {
    background: var(--bandeau);
    color: var(--bandeau-texte);
    padding-block: clamp(40px, 6vw, 72px);
  }
  .appel-grille {
    display: grid;
    gap: 20px;
    align-items: center;
  }
  @media (min-width: 860px) {
    .appel-grille {
      grid-template-columns: minmax(0, 1.6fr) auto;
      gap: 40px;
    }
  }
  .appel h2 {
    margin: 0 0 10px;
    color: #ffffff;
  }
  .appel p {
    margin: 0;
    color: #dfe7fb;
  }
  .appel-adresse .adresse {
    display: inline-block;
    background: var(--lime);
    color: var(--encre-marine);
    font-weight: 600;
    font-size: 1.1rem;
    padding: 12px 20px;
    border-radius: var(--rayon-petit);
    user-select: all;
    overflow-wrap: anywhere;
  }
</style>

<script>
  // Recherche, filtres, tri et affichage par paquets, entièrement dans le navigateur.
  // Aucune donnée n'est envoyée nulle part. Sans JavaScript, toute la liste reste visible.
  const PAQUET = 24; // même valeur que dans la page (rendu et CSS « li:nth-child(n + 25) »)
  const CHAMPS = ["q", "discipline", "type", "secteur", "ville", "aides", "tri"];
  // Filtres comptés et affichés en puces (la recherche a sa propre puce, le tri n'en a pas).
  const LIBELLES: Record<string, string> = {
    discipline: "Discipline",
    type: "Type",
    secteur: "Secteur",
    ville: "Ville",
    aides: "Éligible aux aides",
  };

  const html = document.documentElement;
  const formulaire = document.getElementById("filtres") as HTMLFormElement;
  const liste = document.getElementById("liste") as HTMLUListElement;

  try {
    const rechercheHeros = document.querySelector<HTMLFormElement>(".recherche-heros")!;
    const qHeros = rechercheHeros.elements.namedItem("q") as HTMLInputElement;
    const qListe = formulaire.elements.namedItem("q") as HTMLInputElement;
    const tri = document.querySelector<HTMLSelectElement>('select[name="tri"]');
    const points = [...document.querySelectorAll<SVGGElement>(".point")];
    const resultat = document.getElementById("resultat")!;
    const aucun = document.getElementById("aucun")!;
    const plusBloc = document.getElementById("plus-bloc");
    const compteur = document.getElementById("compteur");
    const plus = document.getElementById("plus") as HTMLButtonElement | null;
    const puces = document.getElementById("puces")!;
    const boutonFiltres = document.getElementById("bouton-filtres")!;
    const compteFiltres = document.getElementById("compte-filtres")!;
    const pastilles = [...document.querySelectorAll<HTMLAnchorElement>(".pastille")];
    const doux: ScrollBehavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";

    const normaliser = (s: string) =>
      s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();

    // Les attributs data-* de chaque carte sont lus une seule fois.
    const SANS_PRIX = 1e12;
    const fiches = [...liste.children].map((el, rang) => {
      const li = el as HTMLLIElement;
      const d = li.dataset;
      return {
        li,
        rang, // ordre alphabétique de la page
        disciplines: (d.disciplines ?? "").split(" "),
        type: d.type ?? "",
        secteur: d.secteur ?? "",
        villes: (d.villes ?? "").split("|").filter(Boolean),
        aides: (d.aides ?? "").split(" ").filter(Boolean),
        texte: null as string | null, // calculé à la première recherche
        debut: d.debut ?? "",
        prix: d.prix ? Number(d.prix) : SANS_PRIX,
        titre: null as string | null,
      };
    });
    type Fiche = (typeof fiches)[number];

    // Texte cherché : le texte visible de la carte (sans les libellés « Lieu : », « Durée : »…)
    // et les précisions de la fiche. Lu une fois, à la première recherche.
    function texteDe(x: Fiche) {
      if (x.texte === null) {
        let t = x.li.dataset.precisions ?? "";
        const parcours = document.createTreeWalker(x.li, NodeFilter.SHOW_TEXT);
        while (parcours.nextNode()) {
          const parent = parcours.currentNode.parentElement;
          if (!parent?.matches(".invisible, .libelle")) t += " " + parcours.currentNode.nodeValue;
        }
        x.texte = " " + normaliser(t) + " ";
      }
      return x.texte;
    }
    type Filtres = Record<string, string>;
    let affichage: Fiche[] = []; // cartes affichées, dans l'ordre
    let affichees = PAQUET;

    // Filtres repris de l'adresse (?discipline=paro…) : liens partageables et pastilles.
    // Une valeur absente des listes est ignorée par le navigateur (le champ reste sur « Toutes »).
    const parametres = new URLSearchParams(location.search);
    for (const nom of CHAMPS) {
      const valeur = parametres.get(nom);
      const champ = formulaire.elements.namedItem(nom) as HTMLInputElement | HTMLSelectElement | null;
      if (valeur && champ) champ.value = valeur.slice(0, 100);
    }
    qHeros.value = qListe.value;
    // Nombre de cartes déjà dépliées (retour arrière depuis une fiche) : gardé dans l'historique.
    const etat = history.state as { affichees?: number } | null;
    if (etat?.affichees && etat.affichees > PAQUET) affichees = Math.min(etat.affichees, fiches.length);

    const lireFiltres = () => Object.fromEntries(new FormData(formulaire)) as Filtres;

    // L'adresse suit les filtres, sans recharger la page ni créer d'entrée d'historique.
    function majAdresse(f: Filtres) {
      const p = new URLSearchParams();
      for (const nom of CHAMPS) if (f[nom]) p.set(nom, f[nom]);
      const requete = p.toString();
      history.replaceState({ affichees }, "", `${location.pathname}${requete ? "?" + requete : ""}${location.hash}`);
    }

    // Tous les critères sauf la ville (la carte compte par ville avec les autres filtres).
    function correspond(x: Fiche, f: Filtres, mots: string[]) {
      if (f.discipline && !x.disciplines.includes(f.discipline)) return false;
      if (f.type && x.type !== f.type) return false;
      if (f.secteur && x.secteur !== f.secteur) return false;
      // « oui » : au moins une prise en charge ; sinon une prise en charge précise (dpc, opco…).
      if (f.aides === "oui" && x.aides.length === 0) return false;
      if (f.aides && f.aides !== "oui" && !x.aides.includes(f.aides)) return false;
      return mots.length === 0 || mots.every((mot) => texteDe(x).includes(mot));
    }

    // Pertinence : sans recherche, l'ordre alphabétique ; avec une recherche, les fiches dont
    // l'intitulé contient tous les mots d'abord. Prochaine session : les plus proches d'abord.
    // Prix : du moins cher au plus cher. Les fiches sans date ou sans prix vont à la fin.
    function ordonner(f: Filtres, mots: string[]) {
      const ordre = [...fiches];
      if (f.tri === "session") {
        ordre.sort((a, b) => (a.debut || "9999").localeCompare(b.debut || "9999") || a.rang - b.rang);
      } else if (f.tri === "prix") {
        ordre.sort((a, b) => a.prix - b.prix || a.rang - b.rang);
      } else if (mots.length) {
        const dansTitre = (x: Fiche) => {
          x.titre ??= normaliser(x.li.querySelector("h3")?.textContent ?? "");
          return mots.every((m) => x.titre!.includes(m)) ? 1 : 0;
        };
        ordre.sort((a, b) => dansTitre(b) - dansTitre(a) || a.rang - b.rang);
      }
      return ordre;
    }

    function appliquer(depuisLeDebut = true) {
      const f = lireFiltres();
      const mots = f.q ? normaliser(f.q).split(" ").filter(Boolean) : [];
      if (depuisLeDebut) affichees = PAQUET;

      // Seules les cartes affichées comptent pour l'ordre à l'écran : si elles ne sont pas dans
      // le bon ordre, on ne déplace qu'elles (24 cartes, pas 1 000), en fin de liste.
      const ordre = ordonner(f, mots);
      let total = 0;
      const montrees: Fiche[] = [];
      const parVille = new Map<string, number>();
      for (const x of ordre) {
        const sansVille = correspond(x, f, mots);
        if (sansVille) for (const v of x.villes) parVille.set(v, (parVille.get(v) ?? 0) + 1);
        const ok = sansVille && (!f.ville || x.villes.includes(f.ville));
        if (ok && ++total <= affichees) montrees.push(x);
        const cache = !ok || total > affichees;
        if (x.li.hidden !== cache) x.li.hidden = cache;
      }
      const enOrdre = montrees.every(
        (x, i) => i === 0 || Boolean(montrees[i - 1].li.compareDocumentPosition(x.li) & Node.DOCUMENT_POSITION_FOLLOWING),
      );
      if (!enOrdre) liste.append(...montrees.map((x) => x.li));
      affichage = montrees;
      liste.classList.add("pilotee");

      resultat.textContent = `${total} formation${total > 1 ? "s" : ""}`;
      aucun.hidden = total > 0;
      if (plusBloc && compteur && plus) {
        const nb = montrees.length;
        plusBloc.hidden = total <= nb;
        compteur.textContent = `${nb} sur ${total} formation${total > 1 ? "s" : ""} affichée${nb > 1 ? "s" : ""}`;
        const suivantes = Math.min(PAQUET, total - nb);
        plus.textContent = `Afficher ${suivantes} formation${suivantes > 1 ? "s" : ""} de plus`;
      }
      for (const a of pastilles) a.setAttribute("aria-current", String(a.dataset.discipline === f.discipline));
      majPuces(f);
      majAdresse(f);

      // Les nombres de la carte suivent les autres filtres, pas celui de la ville.
      for (const p of points) {
        const ville = p.dataset.ville!;
        const n = parVille.get(ville) ?? 0;
        p.querySelector(".nombre")!.textContent = String(n);
        p.classList.toggle("vide", n === 0);
        p.setAttribute("aria-pressed", String(f.ville === ville));
        p.setAttribute("aria-label", `${ville} : ${n} formation${n > 1 ? "s" : ""}`);
      }
    }

    // Puces des filtres actifs (supprimables d'un geste) et nombre de filtres sur le bouton.
    function puce(texte: string, etiquette: string, retirer: () => void, classe = "") {
      const li = document.createElement("li");
      const b = document.createElement("button");
      b.type = "button";
      if (classe) b.className = classe;
      // Le nom lu par les lecteurs d'écran contient toujours le texte visible (WCAG 2.5.3).
      if (etiquette) b.setAttribute("aria-label", etiquette);
      b.append(texte);
      if (!classe) {
        const croix = document.createElement("span");
        croix.className = "croix";
        croix.setAttribute("aria-hidden", "true");
        croix.textContent = "×";
        b.append(croix);
      }
      b.addEventListener("click", () => {
        // Le focus passe à la puce qui prend la place (ou au nombre de résultats) pour ne pas se perdre.
        const rang = [...puces.children].indexOf(li);
        retirer();
        appliquer();
        const restants = puces.querySelectorAll("button");
        const cible = restants[Math.min(rang, restants.length - 1)] ?? resultat;
        cible.focus({ preventScroll: true });
      });
      li.append(b);
      return li;
    }

    function majPuces(f: Filtres) {
      const elements: HTMLLIElement[] = [];
      let nombre = 0;
      if (f.q) {
        elements.push(puce(`« ${f.q} »`, `Retirer la recherche « ${f.q} »`, () => (qListe.value = qHeros.value = "")));
      }
      for (const [nom, libelle] of Object.entries(LIBELLES)) {
        const champ = formulaire.elements.namedItem(nom) as HTMLSelectElement | null;
        if (!champ || !f[nom]) continue;
        nombre++;
        const texte = champ.selectedOptions[0]?.text ?? f[nom];
        elements.push(puce(texte, `Retirer le filtre ${libelle} : ${texte}`, () => (champ.value = "")));
      }
      if (elements.length > 1) {
        elements.push(puce("Tout effacer", "", () => {
          const t = tri?.value ?? "";
          formulaire.reset();
          if (tri) tri.value = t; // le tri n'est pas un filtre : on le garde
          qHeros.value = "";
        }, "tout-effacer"));
      }
      puces.replaceChildren(...elements);
      puces.hidden = elements.length === 0;
      compteFiltres.hidden = nombre === 0;
      compteFiltres.textContent = String(nombre);
      boutonFiltres.setAttribute("aria-label", nombre ? `Filtres, ${nombre} actif${nombre > 1 ? "s" : ""}` : "Filtres");
    }

    // Amène la recherche et les premiers résultats à l'écran, et y place le focus
    // (sur le nombre de résultats : le clavier du téléphone se referme).
    function allerAuxResultats() {
      formulaire.scrollIntoView({ behavior: doux, block: "start" });
      resultat.focus({ preventScroll: true });
    }

    // Recherche du haut de page : elle alimente la recherche de la liste.
    qHeros.addEventListener("input", () => {
      qListe.value = qHeros.value;
      appliquer();
    });
    rechercheHeros.addEventListener("submit", (e) => {
      e.preventDefault();
      qListe.value = qHeros.value;
      appliquer();
      allerAuxResultats();
    });
    qListe.addEventListener("input", () => (qHeros.value = qListe.value));

    function choisirVille(ville: string) {
      const champ = formulaire.elements.namedItem("ville") as HTMLSelectElement;
      champ.value = champ.value === ville ? "" : ville;
      appliquer();
      allerAuxResultats();
    }
    for (const p of points) {
      p.addEventListener("click", () => choisirVille(p.dataset.ville!));
      p.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          choisirVille(p.dataset.ville!);
        }
      });
    }
    for (const a of pastilles) {
      a.addEventListener("click", (e) => {
        e.preventDefault();
        const champ = formulaire.elements.namedItem("discipline") as HTMLSelectElement;
        champ.value = champ.value === a.dataset.discipline ? "" : a.dataset.discipline!;
        appliquer();
        allerAuxResultats();
      });
    }

    // Afficher plus : le paquet suivant, et le focus sur la première nouvelle carte.
    plus?.addEventListener("click", () => {
      const premiere = affichage.length;
      affichees += PAQUET;
      appliquer(false);
      affichage[premiere]?.li.querySelector("a")?.focus();
    });

    // Filtres repliables (téléphone et tablette)
    boutonFiltres.addEventListener("click", () => {
      const ouvert = boutonFiltres.getAttribute("aria-expanded") !== "true";
      boutonFiltres.setAttribute("aria-expanded", String(ouvert));
      formulaire.classList.toggle("ouvert", ouvert);
    });

    formulaire.addEventListener("input", () => appliquer());
    tri?.addEventListener("input", () => appliquer());
    formulaire.addEventListener("submit", (e) => {
      e.preventDefault();
      allerAuxResultats();
    });
    formulaire.addEventListener("reset", () =>
      setTimeout(() => {
        qHeros.value = "";
        appliquer();
      }, 0),
    );
    appliquer(false);

    // Le texte des cartes est préparé pendant les temps morts, par petits lots :
    // la première lettre tapée dans la recherche ne fait pas attendre.
    let prepares = 0;
    const preparer = () => {
      const fin = Math.min(prepares + 100, fiches.length);
      while (prepares < fin) texteDe(fiches[prepares++]);
      if (prepares < fiches.length) plusTard(preparer);
    };
    const plusTard = (f: () => void) =>
      "requestIdleCallback" in window ? requestIdleCallback(f, { timeout: 2000 }) : setTimeout(f, 50);
    plusTard(preparer);
  } catch (erreur) {
    // En cas de souci, on revient à la page sans JavaScript : toute la liste, sans filtres.
    html.classList.remove("js");
    for (const li of liste.children) (li as HTMLElement).hidden = false;
    throw erreur;
  }
</script>
