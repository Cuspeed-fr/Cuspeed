    color: var(--accent-fort);
    background: none;
    border: 1px solid var(--trait);
    border-radius: var(--rayon-petit);
    padding: 10px 12px;
    cursor: pointer;
  }
  .effacer:hover {
    border-color: var(--accent);
  }

  /* Nombre de résultats */
  .barre-resultat {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    margin-top: 4px;
  }
  .resultat {
    margin: 0 2px;
    font-family: var(--titre);
    font-weight: 700;
    font-size: 1.25rem;
  }
  /* Le nombre de résultats reçoit le focus après une recherche (sans ouvrir le clavier) */
  .resultat:focus {
    outline: none;
  }
  /* Puces des filtres actifs : un geste pour retirer un filtre. Elles sont créées par le
     script, d'où :global() (le style limité à la page ne les atteindrait pas). */
  .puces-actives {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
